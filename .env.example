# TBX environment example. Copy to .env and adjust. Blank values fall back to defaults.

# --- Database ---
POSTGRES_DSN=postgresql+asyncpg://tbx_app:tbx_app@postgres:5432/tbx
POSTGRES_READER_USER=tbx_reader
POSTGRES_READER_PASSWORD=tbx_reader
POSTGRES_READER_DSN=postgresql+asyncpg://tbx_reader:tbx_reader@postgres:5432/tbx
READER_POOL_SIZE=10
# AES-256 key (base64) for encrypting sensitive PII columns (account_number, utr_number) at rest.
# Generate with: python -m scripts.gen_pii_key   — blank disables encryption (dev only; warns).
PII_ENCRYPTION_KEY=

# --- Runtime ---
BIND_HOST=127.0.0.1
# Shared-secret header for internal/admin routes. Unset => API is unauthenticated (startup warns).
INTERNAL_API_TOKEN=

# --- Model provider (Strands) ---
# Per-role provider/model resolution is read from role config; leave provider creds blank
# for an offline (no-LLM) run — the templated answer path still functions.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- Groq (via Strands OpenAI-compatible provider) ---
# Set your Groq API key and the exact Groq model slugs for each role.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
SQL_GENERATOR_MODEL=qwen-2.5-coder-32b
REVIEWER_MODEL=llama-3.3-70b-versatile
MODEL_REQUEST_TIMEOUT=30

# --- Sarvam voice (optional) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_PACE=1.0
SARVAM_PITCH=1.0

# --- Budgets (see requirements.md Configuration Inventory for all defaults) ---
MAX_LLM_CALLS_PER_QUESTION=6
MAX_TOKENS_PER_QUESTION=12000
QUESTION_WALLCLOCK_DEADLINE=30
